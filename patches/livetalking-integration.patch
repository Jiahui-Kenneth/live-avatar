+import numpy as np
+
+from server.avatar_image import (
+    MAX_IMAGE_BYTES,
+    AvatarImageError,
+    validate_avatar_image,
+    write_still_video,
+)
+
+
+class AvatarImageTest(unittest.TestCase):
+    def encoded(self, width=576, height=768, extension=".jpg"):
+        image = np.zeros((height, width, 3), dtype=np.uint8)
+        ok, data = cv2.imencode(extension, image)
+        self.assertTrue(ok)
+        return data.tobytes()
+
+    def assert_error_code(self, code, payload, detector):
+        with self.assertRaises(AvatarImageError) as raised:
+            validate_avatar_image(payload, detector)
+        self.assertEqual(raised.exception.code, code)
+
+    def test_accepts_one_large_face(self):
+        out = validate_avatar_image(
+            self.encoded(),
+            lambda image: [(160, 120, 416, 500, 0.99)],
+        )
+        self.assertEqual(out.image_bgr.shape, (768, 576, 3))
+        self.assertEqual(out.face_box, (160, 120, 416, 500))
+
+    def test_rejects_payload_larger_than_ten_mib(self):
+        self.assert_error_code(
+            "image_too_large",
+            b"x" * (MAX_IMAGE_BYTES + 1),
+            lambda image: [],
+        )
+
+    def test_rejects_corrupt_and_wrong_size_images(self):
+        self.assert_error_code("invalid_image", b"not-an-image", lambda image: [])
+        self.assert_error_code(
+            "wrong_dimensions",
+            self.encoded(width=575),
+            lambda image: [(0, 0, 200, 200, 0.99)],
+        )
+
+    def test_rejects_zero_or_multiple_significant_faces(self):
+        self.assert_error_code("no_face", self.encoded(), lambda image: [])
+        self.assert_error_code(
+            "no_face",
+            self.encoded(),
+            lambda image: [(100, 100, 400, 500, 0.49)],
+        )
+        self.assert_error_code(
+            "multiple_faces",
+            self.encoded(),
+            lambda image: [
+                (50, 50, 250, 300, 0.99),
+                (300, 80, 500, 330, 0.96),
+            ],
+        )
+
+    def test_rejects_face_smaller_than_minimum_wav2lip_crop(self):
+        self.assert_error_code(
+            "face_too_small",
+            self.encoded(),
+            lambda image: [(0, 0, 60, 60, 0.99)],
+        )
+
+    def test_writes_exactly_twenty_five_still_frames(self):
+        image = np.zeros((768, 576, 3), dtype=np.uint8)
+        with tempfile.TemporaryDirectory() as temp:
+            target = Path(temp) / "still.mp4"
+            write_still_video(image, target)
+            capture = cv2.VideoCapture(str(target))
+            try:
+                decoded = 0
+                while True:
+                    ok, frame = capture.read()
+                    if not ok:
+                        break
+                    self.assertEqual(frame.shape, image.shape)
+                    decoded += 1
+            finally:
+                capture.release()
+            self.assertEqual(decoded, 25)
+
+
+if __name__ == "__main__":
+    unittest.main()
