{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HeiXia2077/live-avatar/installer/components.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "install_kind", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "install_kind": {"enum": ["python_exe", "zip", "zip_overlay", "google_drive", "google_drive_archive", "git_source", "python_package"]},
          "version": {"type": "string", "minLength": 1},
          "filename": {"type": "string"},
          "urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required_files": {"type": "array", "items": {"type": "string"}},
          "file_id": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "package": {"type": "string"},
          "index_url": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  }
}
