+import unittest
+from types import SimpleNamespace
+
+from server.rtc_manager import RTCManager
+from server.session_manager import session_manager
+
+
+class FakePc:
+    def __init__(self):
+        self.closed = False
+
+    async def close(self):
+        self.closed = True
+
+
+class RTCSessionCloseTest(unittest.IsolatedAsyncioTestCase):
+    async def asyncTearDown(self):
+        session_manager.sessions.clear()
+
+    async def test_close_session_closes_pc_and_removes_avatar_session(self):
+        manager = RTCManager(SimpleNamespace(stun=""))
+        pc = FakePc()
+        manager.pcs.add(pc)
+        manager.session_pcs["sid"] = pc
+        session_manager.sessions["sid"] = object()
+
+        self.assertTrue(await manager.close_session("sid"))
+        self.assertTrue(pc.closed)
+        self.assertNotIn("sid", session_manager.sessions)
+        self.assertNotIn("sid", manager.session_pcs)
+        self.assertNotIn(pc, manager.pcs)
+
+    async def test_close_missing_session_is_idempotent(self):
+        manager = RTCManager(SimpleNamespace(stun=""))
+        session_manager.sessions["missing"] = object()
+        self.assertFalse(await manager.close_session("missing"))
+        self.assertNotIn("missing", session_manager.sessions)
+
+
+if __name__ == "__main__":
+    unittest.main()
