diff --git a/tests/test_avatar_store.py b/tests/test_avatar_store.py
new file mode 100644
index 0000000..03c3998
--- /dev/null
+++ b/tests/test_avatar_store.py
@@ -0,0 +1,101 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from server.avatar_store import AvatarConflict, AvatarInvalid, AvatarStore
+
+
+class AvatarStoreTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.store = AvatarStore(self.root, {"myavatar"})
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def make_avatar(self, avatar_id: str) -> Path:
+        staged = self.root / "temp" / avatar_id
+        (staged / "full_imgs").mkdir(parents=True)
+        (staged / "face_imgs").mkdir()
+        (staged / "full_imgs" / "00000000.png").write_bytes(b"full")
+        (staged / "face_imgs" / "00000000.png").write_bytes(b"face")
+        (staged / "coords.pkl").write_bytes(b"coords")
+        return staged
+
+    def test_commit_activate_and_list(self):
+        staged = self.make_avatar("avatar_abc")
+
+        target = self.store.commit_staging(
+            staged,
+            {"avatar_id": "avatar_abc", "display_name": "Alice", "created_at": "2026-08-15T00:00:00Z"},
+        )
+        active = self.store.activate("avatar_abc", "avatar_abc")
+        items = self.store.list_avatars()
+
+        self.assertEqual(target, self.root / "avatars" / "avatar_abc")
+        self.assertFalse(staged.exists())
+        self.assertEqual(active["avatar_id"], "avatar_abc")
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["display_name"], "Alice")
+        self.assertTrue(items[0]["active"])
+        persisted = json.loads((target / "metadata.json").read_text(encoding="utf-8"))
+        self.assertEqual(persisted["avatar_id"], "avatar_abc")
+
+    def test_delete_rejects_active_builtin_and_in_use(self):
+        with self.assertRaisesRegex(AvatarConflict, "built-in"):
+            self.store.delete("myavatar", set())
+
+        for avatar_id in ("avatar_active", "avatar_busy"):
+            self.store.commit_staging(
+                self.make_avatar(avatar_id),
+                {"avatar_id": avatar_id, "display_name": avatar_id},
+            )
+        self.store.activate("avatar_active", "avatar_active")
+
+        with self.assertRaisesRegex(AvatarConflict, "active"):
+            self.store.delete("avatar_active", set())
+        with self.assertRaisesRegex(AvatarConflict, "in use"):
+            self.store.delete("avatar_busy", {"avatar_busy"})
+
+    def test_commit_rejects_missing_generated_assets_and_existing_id(self):
+        incomplete = self.root / "temp" / "avatar_bad"
+        incomplete.mkdir(parents=True)
+        with self.assertRaisesRegex(AvatarInvalid, "full_imgs"):
+            self.store.commit_staging(incomplete, {"avatar_id": "avatar_bad"})
+
+        self.store.commit_staging(
+            self.make_avatar("avatar_dup"),
+            {"avatar_id": "avatar_dup", "display_name": "first"},
+        )
+        with self.assertRaisesRegex(AvatarConflict, "already exists"):
+            self.store.commit_staging(
+                self.make_avatar("avatar_dup_second"),
+                {"avatar_id": "avatar_dup", "display_name": "second"},
+            )
+
+    def test_activate_requires_live_session_to_match_avatar(self):
+        self.store.commit_staging(
+            self.make_avatar("avatar_new"),
+            {"avatar_id": "avatar_new", "display_name": "new"},
+        )
+
+        with self.assertRaisesRegex(AvatarConflict, "session avatar"):
+            self.store.activate("avatar_new", "avatar_old")
+
+        self.assertIsNone(self.store.get_active())
+
+    def test_delete_removes_an_unused_custom_avatar(self):
+        target = self.store.commit_staging(
+            self.make_avatar("avatar_unused"),
+            {"avatar_id": "avatar_unused", "display_name": "unused"},
+        )
+
+        self.store.delete("avatar_unused", set())
+
+        self.assertFalse(target.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
