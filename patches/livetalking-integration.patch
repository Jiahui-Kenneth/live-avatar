+++ b/tests/test_avatar_auth.py
@@ -0,0 +1,75 @@
+import unittest
+
+from aiohttp import web
+
+from server.avatar_auth import AvatarAdminGuard, mint_capability
+
+
+class FakeRequest:
+    def __init__(self, capability, origin, host="127.0.0.1:8010"):
+        self.headers = {
+            "X-Live-Avatar-Capability": capability,
+            "Origin": origin,
+            "Host": host,
+        }
+
+
+class AvatarAdminGuardTest(unittest.TestCase):
+    def setUp(self):
+        self.now = 2_000_000_000
+        self.origin = "http://127.0.0.1:7860"
+        self.guard = AvatarAdminGuard("secret", {self.origin}, now=lambda: self.now)
+        self.valid = mint_capability("secret", self.origin, self.now + 300, "nonce")
+
+    def assert_forbidden(self, request):
+        with self.assertRaises(web.HTTPForbidden):
+            self.guard.require(request)
+
+    def test_accepts_exact_token_origin_and_loopback(self):
+        self.guard.require(FakeRequest(self.valid, self.origin))
+        self.guard.require(FakeRequest(self.valid, self.origin, "127.99.1.2:8010"))
+        self.guard.require(FakeRequest(self.valid, self.origin, "[::1]:8010"))
+
+    def test_rejects_wrong_secret_origin_host_and_time(self):
+        requests = (
+            FakeRequest(
+                mint_capability("wrong", self.origin, self.now + 300, "nonce"),
+                self.origin,
+            ),
+            FakeRequest(self.valid, "https://evil.example"),
+            FakeRequest(self.valid, self.origin, "192.168.1.5:8010"),
+            FakeRequest(self.valid, self.origin, "localhost:8010"),
+            FakeRequest(
+                mint_capability("secret", self.origin, self.now - 1, "nonce"),
+                self.origin,
+            ),
+            FakeRequest(
+                mint_capability("secret", self.origin, self.now + 301, "nonce"),
+                self.origin,
+            ),
+        )
+        for request in requests:
+            with self.subTest(request=request.headers):
+                self.assert_forbidden(request)
+
+    def test_rejects_missing_or_malformed_capability(self):
+        for capability in ("", "nope", "v1.bad.nonce.signature", "v2.1.nonce.sig"):
+            with self.subTest(capability=capability):
+                self.assert_forbidden(FakeRequest(capability, self.origin))
+
+    def test_signature_is_bound_to_origin_and_nonce(self):
+        other_origin = "http://localhost:7860"
+        guard = AvatarAdminGuard(
+            "secret",
+            {self.origin, other_origin},
+            now=lambda: self.now,
+        )
+        with self.assertRaises(web.HTTPForbidden):
+            guard.require(FakeRequest(self.valid, other_origin))
+        forged = self.valid.replace(".nonce.", ".changed.")
+        with self.assertRaises(web.HTTPForbidden):
+            guard.require(FakeRequest(forged, self.origin))
+
+
+if __name__ == "__main__":
+    unittest.main()
