+async def humanpcm(request):
+    """流式驱动：接收 16kHz int16 PCM 音频体，切块后驱动口型。
+
+    与 /humanaudio 不同，本接口接收裸 PCM 而非 WAV 容器，适合
+    s2s 管道边生成边推流。body 为二进制 PCM16 LE（mono, 16kHz）。
+    可选 query 参数 rate/sample_rate 指定输入采样率（默认 16000），
+    非 16kHz 时自动重采样。
+    """
+    import numpy as np
+    import resampy
+    try:
+        raw = await request.read()
+        params = request.query
+        sessionid = params.get('sessionid', '')
+        if not sessionid:
+            sessionid = request.headers.get('X-Session-ID', '')
+        if not sessionid:
+            return json_error("sessionid required")
+
+        in_rate = int(params.get('rate', params.get('sample_rate', 16000)))
+        avatar_session = get_session(request, sessionid)
+        if avatar_session is None:
+            return json_error("session not found")
+
+        if not raw:
+            return json_ok()
+
+        pcm = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
+        if pcm.shape[0] == 0:
+            return json_ok()
+
+        if in_rate != avatar_session.sample_rate:
+            pcm = resampy.resample(pcm, sr_orig=in_rate, sr_new=avatar_session.sample_rate)
+
+        chunk = avatar_session.chunk  # 320 samples @ 16kHz = 20ms
+        idx = 0
+        n = pcm.shape[0]
+        datainfo = {}
+        first = True
+        while n - idx >= chunk:
+            eventpoint = {}
+            if first:
+                eventpoint = {'status': 'start'}
+                first = False
+            if n - idx - chunk < chunk:
+                eventpoint = {'status': 'end'}
+            eventpoint.update(**datainfo)
+            avatar_session.put_audio_frame(pcm[idx:idx + chunk], eventpoint)
+            idx += chunk
+        return json_ok()
+    except Exception as e:
+        logger.exception('humanpcm exception:')
+        return json_error(str(e))
+
+
