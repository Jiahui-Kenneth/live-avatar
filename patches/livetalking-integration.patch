diff --git a/server/avatar_auth.py b/server/avatar_auth.py
new file mode 100644
index 0000000..36454ce
--- /dev/null
+++ b/server/avatar_auth.py
@@ -0,0 +1,96 @@
+import base64
+import hashlib
+import hmac
+import ipaddress
+import re
+import secrets
+import time
+from collections.abc import Callable, Iterable
+from urllib.parse import urlsplit
+
+from aiohttp import web
+
+
+CAPABILITY_VERSION = "v1"
+CAPABILITY_HEADER = "X-Live-Avatar-Capability"
+MAX_CAPABILITY_LIFETIME_SECONDS = 300
+NONCE_RE = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
+LOOPBACK_V4 = ipaddress.ip_network("127.0.0.0/8")
+LOOPBACK_V6 = ipaddress.ip_address("::1")
+
+
+def _base64url(payload: bytes) -> str:
+    return base64.urlsafe_b64encode(payload).decode("ascii").rstrip("=")
+
+
+def _message(origin: str, expires: int, nonce: str) -> bytes:
+    return f"{CAPABILITY_VERSION}\n{origin}\n{expires}\n{nonce}".encode("utf-8")
+
+
+def mint_capability(master_token: str, origin: str, expires: int, nonce: str) -> str:
+    if not master_token:
+        raise ValueError("master token is required")
+    if not origin:
+        raise ValueError("origin is required")
+    if not NONCE_RE.fullmatch(nonce):
+        raise ValueError("nonce must be base64url text")
+    expires = int(expires)
+    signature = hmac.new(
+        master_token.encode("utf-8"),
+        _message(origin, expires, nonce),
+        hashlib.sha256,
+    ).digest()
+    return f"{CAPABILITY_VERSION}.{expires}.{nonce}.{_base64url(signature)}"
+
+
+def _loopback_host(host_header: str) -> bool:
+    try:
+        hostname = urlsplit(f"//{host_header}").hostname
+        address = ipaddress.ip_address(hostname)
+    except (TypeError, ValueError):
+        return False
+    if isinstance(address, ipaddress.IPv4Address):
+        return address in LOOPBACK_V4
+    return address == LOOPBACK_V6
+
+
+class AvatarAdminGuard:
+    def __init__(
+        self,
+        master_token: str,
+        allowed_origins: Iterable[str],
+        now: Callable[[], float] = time.time,
+    ):
+        if not master_token:
+            raise ValueError("master token is required")
+        self._master_token = master_token
+        self._allowed_origins = frozenset(origin for origin in allowed_origins if origin)
+        self._now = now
+
+    def require(self, request) -> None:
+        origin = request.headers.get("Origin", "")
+        capability = request.headers.get(CAPABILITY_HEADER, "")
+        host = request.headers.get("Host", "")
+        if origin not in self._allowed_origins or not _loopback_host(host):
+            raise web.HTTPForbidden()
+
+        parts = capability.split(".")
+        if len(parts) != 4 or parts[0] != CAPABILITY_VERSION:
+            raise web.HTTPForbidden()
+        _, expires_text, nonce, supplied_signature = parts
+        if not expires_text.isdigit() or not NONCE_RE.fullmatch(nonce):
+            raise web.HTTPForbidden()
+
+        expires = int(expires_text)
+        current = int(self._now())
+        if expires < current or expires > current + MAX_CAPABILITY_LIFETIME_SECONDS:
+            raise web.HTTPForbidden()
+
+        expected = mint_capability(
+            self._master_token,
+            origin,
+            expires,
+            nonce,
+        ).rsplit(".", 1)[1]
+        if not secrets.compare_digest(supplied_signature, expected):
+            raise web.HTTPForbidden()
diff --git a/server/avatar_image.py b/server/avatar_image.py
new file mode 100644
index 0000000..383b7b1
--- /dev/null
+++ b/server/avatar_image.py
@@ -0,0 +1,110 @@
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable, Iterable, Sequence
+
+import cv2
+import numpy as np
+
+
+MAX_IMAGE_BYTES = 10 * 1024 * 1024
+TARGET_WIDTH = 576
+TARGET_HEIGHT = 768
+MIN_FACE_AREA_RATIO = 0.02
+MIN_FACE_EDGE = 96
+MIN_FACE_CONFIDENCE = 0.5
+
+
+class AvatarImageError(ValueError):
+    def __init__(self, code: str, message: str):
+        self.code = code
+        self.message = message
+        super().__init__(f"{code}: {message}")
+
+
+@dataclass(frozen=True)
+class ValidatedImage:
+    image_bgr: np.ndarray
+    face_box: tuple[int, int, int, int]
+
+
+def validate_avatar_image(
+    payload: bytes,
+    detect_faces: Callable[[np.ndarray], Iterable[Sequence[float]]],
+) -> ValidatedImage:
+    if len(payload) > MAX_IMAGE_BYTES:
+        raise AvatarImageError("image_too_large", "Image exceeds 10 MiB")
+
+    raw = np.frombuffer(payload, dtype=np.uint8)
+    image = cv2.imdecode(raw, cv2.IMREAD_COLOR)
+    if image is None:
+        raise AvatarImageError("invalid_image", "JPEG, PNG, or WebP required")
+    if image.shape[:2] != (TARGET_HEIGHT, TARGET_WIDTH):
+        raise AvatarImageError("wrong_dimensions", "Image must be 576x768")
+
+    faces = []
+    for box in detect_faces(image):
+        if len(box) >= 5 and float(box[4]) >= MIN_FACE_CONFIDENCE:
+            faces.append(box)
+    if not faces:
+        raise AvatarImageError("no_face", "No face detected")
+    if len(faces) > 1:
+        raise AvatarImageError("multiple_faces", "Multiple faces detected")
+
+    x1, y1, x2, y2 = (float(value) for value in faces[0][:4])
+    face_width = max(0.0, x2 - x1)
+    face_height = max(0.0, y2 - y1)
+    face_area_ratio = face_width * face_height / (TARGET_WIDTH * TARGET_HEIGHT)
+    if face_area_ratio < MIN_FACE_AREA_RATIO or min(face_width, face_height) < MIN_FACE_EDGE:
+        raise AvatarImageError("face_too_small", "Face is too small; crop closer")
+
+    clipped = (
+        max(0, min(TARGET_WIDTH, int(x1))),
+        max(0, min(TARGET_HEIGHT, int(y1))),
+        max(0, min(TARGET_WIDTH, int(x2))),
+        max(0, min(TARGET_HEIGHT, int(y2))),
+    )
+    return ValidatedImage(image_bgr=image, face_box=clipped)
+
+
+def detect_faces_sfd(image_bgr: np.ndarray):
+    import torch
+    from avatars.wav2lip import face_detection
+
+    device = "cuda" if torch.cuda.is_available() else "cpu"
+    detector = face_detection.FaceAlignment(
+        face_detection.LandmarksType._2D,
+        flip_input=False,
+        device=device,
+    )
+    try:
+        image_rgb = image_bgr[..., ::-1].copy()
+        return detector.face_detector.detect_from_image(image_rgb)
+    finally:
+        del detector
+        if device == "cuda":
+            torch.cuda.empty_cache()
+
+
+def write_still_video(
+    image_bgr: np.ndarray,
+    target: Path,
+    fps: int = 25,
+    frames: int = 25,
+) -> None:
+    if image_bgr.shape != (TARGET_HEIGHT, TARGET_WIDTH, 3):
+        raise AvatarImageError("wrong_dimensions", "Image must be 576x768")
+    target = Path(target)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    writer = cv2.VideoWriter(
+        str(target),
+        cv2.VideoWriter_fourcc(*"mp4v"),
+        fps,
+        (TARGET_WIDTH, TARGET_HEIGHT),
+    )
+    if not writer.isOpened():
+        raise AvatarImageError("video_encoder_unavailable", "Cannot create avatar input video")
+    try:
+        for _ in range(frames):
+            writer.write(image_bgr)
+    finally:
+        writer.release()
diff --git a/server/avatar_store.py b/server/avatar_store.py
new file mode 100644
index 0000000..fe65c57
--- /dev/null
+++ b/server/avatar_store.py
@@ -0,0 +1,144 @@
+import json
+import os
+import re
+import shutil
+import threading
+from pathlib import Path
+
+
+AVATAR_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{2,63}$")
+
+
+class AvatarStoreError(RuntimeError):
+    pass
+
+
+class AvatarInvalid(AvatarStoreError):
+    pass
+
+
+class AvatarConflict(AvatarStoreError):
+    pass
+
+
+class AvatarNotFound(AvatarStoreError):
+    pass
+
+
+def validate_avatar_id(avatar_id: str) -> str:
+    value = str(avatar_id or "")
+    if not AVATAR_ID_RE.fullmatch(value):
+        raise AvatarInvalid("avatar_id must contain 3-64 lowercase letters, digits, underscores, or hyphens")
+    return value
+
+
+class AvatarStore:
+    def __init__(self, data_root: Path, builtin_ids: set[str]):
+        self.data_root = Path(data_root).resolve()
+        self.avatars_root = self.data_root / "avatars"
+        self.config_root = self.data_root / "config"
+        self.builtin_ids = frozenset(validate_avatar_id(item) for item in builtin_ids)
+        self.active_path = self.config_root / "active-avatar.json"
+        self._lock = threading.RLock()
+        self.avatars_root.mkdir(parents=True, exist_ok=True)
+        self.config_root.mkdir(parents=True, exist_ok=True)
+
+    def _avatar_path(self, avatar_id: str) -> Path:
+        safe_id = validate_avatar_id(avatar_id)
+        target = (self.avatars_root / safe_id).resolve()
+        if target.parent != self.avatars_root:
+            raise AvatarInvalid("avatar path escapes the avatar data root")
+        return target
+
+    @staticmethod
+    def _read_json(path: Path) -> dict:
+        try:
+            value = json.loads(path.read_text(encoding="utf-8"))
+        except (OSError, ValueError) as exc:
+            raise AvatarInvalid(f"invalid metadata: {path.name}") from exc
+        if not isinstance(value, dict):
+            raise AvatarInvalid(f"invalid metadata: {path.name}")
+        return value
+
+    @staticmethod
+    def _write_json(path: Path, value: dict) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temp = path.with_suffix(path.suffix + ".tmp")
+        temp.write_text(json.dumps(value, ensure_ascii=False, indent=2), encoding="utf-8")
+        os.replace(temp, path)
+
+    def commit_staging(self, staged_avatar: Path, metadata: dict) -> Path:
+        avatar_id = validate_avatar_id(metadata.get("avatar_id", ""))
+        target = self._avatar_path(avatar_id)
+        staged = Path(staged_avatar).resolve()
+        with self._lock:
+            if target.exists():
+                raise AvatarConflict("avatar already exists")
+            if not staged.is_dir():
+                raise AvatarInvalid("staged avatar directory does not exist")
+            for required in ("full_imgs", "face_imgs", "coords.pkl"):
+                if not (staged / required).exists():
+                    raise AvatarInvalid(f"missing generated asset: {required}")
+            stored_metadata = dict(metadata)
+            stored_metadata.setdefault("schema_version", 1)
+            stored_metadata["avatar_id"] = avatar_id
+            stored_metadata.setdefault("built_in", avatar_id in self.builtin_ids)
+            self._write_json(staged / "metadata.json", stored_metadata)
+            os.replace(staged, target)
+        return target
+
+    def get_active(self) -> dict | None:
+        with self._lock:
+            if not self.active_path.exists():
+                return None
+            return self._read_json(self.active_path)
+
+    def activate(self, avatar_id: str, session_avatar_id: str) -> dict:
+        safe_id = validate_avatar_id(avatar_id)
+        if validate_avatar_id(session_avatar_id) != safe_id:
+            raise AvatarConflict("session avatar does not match requested avatar")
+        target = self._avatar_path(safe_id)
+        with self._lock:
+            if not target.is_dir():
+                raise AvatarNotFound("avatar not found")
+            active = {"schema_version": 1, "avatar_id": safe_id}
+            self._write_json(self.active_path, active)
+            return active
+
+    def list_avatars(self) -> list[dict]:
+        with self._lock:
+            active = self.get_active()
+            active_id = active.get("avatar_id") if active else None
+            items = []
+            for child in sorted(self.avatars_root.iterdir(), key=lambda path: path.name):
+                if not child.is_dir() or not AVATAR_ID_RE.fullmatch(child.name):
+                    continue
+                metadata_path = child / "metadata.json"
+                if metadata_path.exists():
+                    metadata = self._read_json(metadata_path)
+                else:
+                    metadata = {
+                        "schema_version": 1,
+                        "avatar_id": child.name,
+                        "display_name": child.name,
+                        "built_in": child.name in self.builtin_ids,
+                    }
+                metadata["active"] = child.name == active_id
+                metadata["has_thumbnail"] = (child / "thumbnail.jpg").is_file()
+                items.append(metadata)
+            return items
+
+    def delete(self, avatar_id: str, in_use_ids: set[str]) -> None:
+        safe_id = validate_avatar_id(avatar_id)
+        target = self._avatar_path(safe_id)
+        with self._lock:
+            if safe_id in self.builtin_ids:
+                raise AvatarConflict("built-in avatar cannot be deleted")
+            active = self.get_active()
+            if active and active.get("avatar_id") == safe_id:
+                raise AvatarConflict("active avatar cannot be deleted")
+            if safe_id in in_use_ids:
+                raise AvatarConflict("avatar is in use")
+            if not target.is_dir():
+                raise AvatarNotFound("avatar not found")
+            shutil.rmtree(target)
