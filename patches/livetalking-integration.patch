+++ b/tests/test_avatar_routes.py
@@ -0,0 +1,244 @@
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import cv2
+import numpy as np
+from aiohttp import FormData, web
+from aiohttp.test_utils import TestClient, TestServer
+
+from server.avatar_auth import AvatarAdminGuard, mint_capability
+from server.avatar_routes import setup_avatar_routes
+from server.avatar_store import AvatarStore
+from server.task_manager import TaskManager
+
+
+ORIGIN = "http://127.0.0.1:7860"
+NOW = 2_000_000_000
+CAPABILITY = mint_capability("secret", ORIGIN, NOW + 300, "route-test")
+ADMIN_HEADERS = {
+    "Origin": ORIGIN,
+    "X-Live-Avatar-Capability": CAPABILITY,
+}
+
+
+class FakeExecutor:
+    def __init__(self):
+        self.submissions = []
+
+    def submit(self, callable_, *args):
+        self.submissions.append((callable_, args))
+
+
+class FakeTaskManager:
+    def __init__(self):
+        self.calls = []
+        self.tasks = {}
+
+    def add_task(self, model, avatar_id, params, **kwargs):
+        self.calls.append((model, avatar_id, params, kwargs))
+        task_id = kwargs["task_id"]
+        self.tasks[task_id] = SimpleNamespace(
+            to_dict=lambda: {
+                "task_id": task_id,
+                "avatar_id": avatar_id,
+                "stage": "queued",
+                "status": "pending",
+            }
+        )
+        return task_id
+
+    def get_task(self, task_id):
+        return self.tasks.get(task_id)
+
+    def list_tasks(self):
+        return [task.to_dict() for task in self.tasks.values()]
+
+    def delete_task(self, task_id):
+        return False, "not supported"
+
+
+class FakeSessionManager:
+    def __init__(self):
+        self.sessions = {}
+
+
+class FakeRTCManager:
+    def __init__(self):
+        self.closed = []
+
+    async def close_session(self, sessionid):
+        self.closed.append(sessionid)
+        return True
+
+
+class AvatarTaskManagerTest(unittest.TestCase):
+    def test_serializes_stage_result_and_runs_callbacks(self):
+        manager = TaskManager(max_workers=1)
+        manager.executor.shutdown(wait=True)
+        manager.executor = FakeExecutor()
+        finalized = []
+
+        def generated(**kwargs):
+            kwargs["progress_callback"](42)
+
+        task_id = manager.add_task(
+            "wav2lip",
+            "avatar_20260815_1234abcd",
+            {"video_path": "input.mp4"},
+            stage="queued",
+            on_success=lambda task: {"avatar_id": task.avatar_id},
+            on_finally=lambda task: finalized.append(task.task_id),
+        )
+        task = manager.get_task(task_id)
+        self.assertEqual(task.to_dict()["stage"], "queued")
+        self.assertNotIn("on_success", task.to_dict())
+        with patch("avatars.wav2lip.genavatar.generate_avatar", generated):
+            manager._run_task(task_id)
+        body = task.to_dict()
+        self.assertEqual(body["status"], "completed")
+        self.assertEqual(body["stage"], "completed")
+        self.assertEqual(body["result"], {"avatar_id": task.avatar_id})
+        self.assertEqual(finalized, [task_id])
+
+
+class AvatarRoutesTest(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.data_root = Path(self.temp.name)
+        self.store = AvatarStore(self.data_root, {"myavatar"})
+        self.guard = AvatarAdminGuard("secret", {ORIGIN}, now=lambda: NOW)
+        self.tasks = FakeTaskManager()
+        self.sessions = FakeSessionManager()
+        self.rtc = FakeRTCManager()
+        self.app = web.Application(client_max_size=12 * 1024 * 1024)
+        setup_avatar_routes(
+            self.app,
+            store=self.store,
+            guard=self.guard,
+            task_manager=self.tasks,
+            session_manager=self.sessions,
+            rtc_manager=self.rtc,
+            detect_faces=lambda image: [(160, 120, 416, 500, 0.99)],
+        )
+        self.client = TestClient(TestServer(self.app))
+        await self.client.start_server()
+
+    async def asyncTearDown(self):
+        await self.client.close()
+        self.temp.cleanup()
+
+    @staticmethod
+    def encoded(width=576, height=768):
+        image = np.zeros((height, width, 3), dtype=np.uint8)
+        ok, data = cv2.imencode(".jpg", image)
+        if not ok:
+            raise RuntimeError("test JPEG encoding failed")
+        return data.tobytes()
+
+    def stage_avatar(self, avatar_id, display_name="Avatar"):
+        staged = self.data_root / "staging" / avatar_id
+        (staged / "full_imgs").mkdir(parents=True)
+        (staged / "face_imgs").mkdir()
+        (staged / "coords.pkl").write_bytes(b"coords")
+        (staged / "thumbnail.jpg").write_bytes(self.encoded())
+        self.store.commit_staging(
+            staged,
+            {
+                "avatar_id": avatar_id,
+                "display_name": display_name,
+                "built_in": avatar_id == "myavatar",
+            },
+        )
+
+    async def post_image(self, payload=None, headers=ADMIN_HEADERS):
+        form = FormData()
+        form.add_field(
+            "image_file",
+            payload if payload is not None else self.encoded(),
+            filename="crop.jpg",
+            content_type="image/jpeg",
+        )
+        form.add_field("display_name", "Alice")
+        return await self.client.post("/api/avatar/image-task", data=form, headers=headers)
+
+    async def test_create_image_task_returns_ids_and_staged_video(self):
+        response = await self.post_image()
+        body = await response.json()
+        self.assertEqual(body["code"], 0)
+        self.assertRegex(body["data"]["avatar_id"], r"^avatar_[0-9]{8}_[a-f0-9]{8}$")
+        self.assertRegex(body["data"]["task_id"], r"^[a-f0-9-]{36}$")
+        model, avatar_id, params, kwargs = self.tasks.calls[0]
+        self.assertEqual(model, "wav2lip")
+        self.assertEqual(avatar_id, body["data"]["avatar_id"])
+        self.assertTrue(Path(params["video_path"]).is_file())
+        self.assertEqual(Path(params["save_path"]).name, "generated")
+        self.assertEqual(kwargs["stage"], "queued")
+
+    async def test_anonymous_upload_is_rejected(self):
+        response = await self.post_image(headers={"Origin": ORIGIN})
+        self.assertEqual(response.status, 403)
+        self.assertEqual(self.tasks.calls, [])
+
+    async def test_invalid_image_returns_stable_code(self):
+        response = await self.post_image(payload=b"not-an-image")
+        body = await response.json()
+        self.assertEqual(body["code"], -1)
+        self.assertEqual(body["error_code"], "invalid_image")
+
+    async def test_list_active_and_thumbnail(self):
+        self.stage_avatar("avatar_abc", "Alice")
+        self.sessions.sessions["sid-new"] = SimpleNamespace(
+            opt=SimpleNamespace(avatar_id="avatar_abc")
+        )
+        activated = await self.client.post(
+            "/api/avatar/activate",
+            json={"avatar_id": "avatar_abc", "sessionid": "sid-new"},
+            headers=ADMIN_HEADERS,
+        )
+        self.assertEqual((await activated.json())["code"], 0)
+        listed = await (await self.client.get("/api/avatar/list")).json()
+        active = await (await self.client.get("/api/avatar/active")).json()
+        self.assertEqual(listed["data"]["avatars"][0]["display_name"], "Alice")
+        self.assertEqual(active["data"]["active"]["avatar_id"], "avatar_abc")
+        thumbnail = await self.client.get("/api/avatar/avatar_abc/thumbnail")
+        self.assertEqual(thumbnail.status, 200)
+        self.assertTrue((await thumbnail.read()).startswith(b"\xff\xd8"))
+
+    async def test_activate_requires_matching_live_session(self):
+        self.stage_avatar("avatar_abc")
+        self.sessions.sessions["sid-old"] = SimpleNamespace(
+            opt=SimpleNamespace(avatar_id="myavatar")
+        )
+        response = await self.client.post(
+            "/api/avatar/activate",
+            json={"avatar_id": "avatar_abc", "sessionid": "sid-old"},
+            headers=ADMIN_HEADERS,
+        )
+        self.assertEqual((await response.json())["code"], -1)
+
+    async def test_thumbnail_traversal_and_protected_delete_are_rejected(self):
+        traversal = await self.client.get("/api/avatar/%2e%2e/thumbnail")
+        self.assertIn(traversal.status, (400, 404))
+        self.stage_avatar("myavatar")
+        response = await self.client.delete(
+            "/api/avatar/myavatar",
+            headers=ADMIN_HEADERS,
+        )
+        self.assertEqual((await response.json())["code"], -1)
+
+    async def test_authenticated_session_close(self):
+        anonymous = await self.client.delete("/api/avatar/session/sid-old")
+        self.assertEqual(anonymous.status, 403)
+        response = await self.client.delete(
+            "/api/avatar/session/sid-old",
+            headers=ADMIN_HEADERS,
+        )
+        self.assertEqual((await response.json())["code"], 0)
+        self.assertEqual(self.rtc.closed, ["sid-old"])
+
+
+if __name__ == "__main__":
+    unittest.main()
