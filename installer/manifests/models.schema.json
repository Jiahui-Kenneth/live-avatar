{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HeiXia2077/live-avatar/installer/models.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "repository", "revision", "filename", "url", "bytes", "sha256", "full_gpu_min_vram_mib", "recommended_vram_mib", "hybrid_min_vram_mib", "ctx_size", "gpu_layers", "hybrid_gpu_layers", "reasoning", "jinja"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "display_name": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "filename": {"type": "string", "pattern": "\\.gguf$"},
          "url": {"type": "string", "pattern": "^https://"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "full_gpu_min_vram_mib": {"type": "integer", "minimum": 1},
          "recommended_vram_mib": {"type": "integer", "minimum": 1},
          "hybrid_min_vram_mib": {"type": "integer", "minimum": 1},
          "ctx_size": {"type": "integer", "minimum": 1},
          "gpu_layers": {"type": "integer", "minimum": 0},
          "hybrid_gpu_layers": {"type": "integer", "minimum": 0},
          "reasoning": {"enum": ["off"]},
          "jinja": {"type": "boolean"}
        }
      }
    }
  }
}
